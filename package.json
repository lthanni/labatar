{
  "name": "avatar-app-3",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vp dev",
    "electron:dev": "concurrently \"vp dev\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "tsc && vp build",
    "electron:build": "pnpm run build && electron-builder",
    "preview": "vp preview",
    "prepare": "vp config"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "ag-grid-react": "^36.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "ag-grid-community": "^36.1.0",
    "concurrently": "^9.2.1",
    "electron": "^39.1.0",
    "electron-builder": "^26.0.12",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wait-on": "^9.0.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  },
  "build": {
    "appId": "com.example.avatarapp",
    "productName": "Avatar App",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
